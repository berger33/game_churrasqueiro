# CHURRASCO! — secure config (nunca commite o .env real)
# Copie para .env e preencha. CI lê as mesmas vars como secrets.

# Firebase — copie de google-services.json ou Firebase Console > Project Settings
CHURRASCO_FIREBASE_PROJECT_ID=churrasco-mestre-da-brasa-REPLACE
CHURRASCO_FIREBASE_API_KEY=AIzaSyREPLACE
CHURRASCO_FIREBASE_APP_ID=1:REPLACE:android:REPLACE
CHURRASCO_FIREBASE_MESSAGING_SENDER_ID=REPLACE
CHURRASCO_FIREBASE_MEASUREMENT_ID=G-REPLACE

# AdMob — AdMob Console > Apps > App settings > App ID
# DEBUG usa IDs de teste do Google (ca-app-pub-394025...), RELEASE são os reais abaixo
CHURRASCO_ADMOB_ANDROID_APP_ID=ca-app-pub-REPLACE~REPLACE
CHURRASCO_ADMOB_IOS_APP_ID=ca-app-pub-REPLACE~REPLACE
CHURRASCO_ADMOB_REWARDED_ID=ca-app-pub-REPLACE/REPLACE
CHURRASCO_ADMOB_INTERSTITIAL_ID=ca-app-pub-REPLACE/REPLACE

# Play Billing — Play Console > Monetization > Products > copie exatamente os IDs
# Devem bater 1:1 com shared/data/iap.json products[].id
# 5+ produtos já validados: 7 existem (starter, noads, 3 moedas, 2 pass)
CHURRASCO_BILLING_STARTER_ID=brasa.starterpack.v1
CHURRASCO_BILLING_NOADS_ID=brasa.noads.v1
CHURRASCO_BILLING_COINS_SMALL=brasa.coins.small.v1
CHURRASCO_BILLING_COINS_MEDIUM=brasa.coins.medium.v1
CHURRASCO_BILLING_COINS_LARGE=brasa.coins.large.v1
CHURRASCO_BILLING_PASS_SEASON=brasa.pass.season.v1
CHURRASCO_BILLING_PASS_BUNDLE=brasa.pass.bundle.v1

# Signing — keystore fora do repo (Play App Signing enrolado)
CHURRASCO_KEYSTORE_PATH=/secure/churrasco-upload.jks
CHURRASCO_KEYSTORE_ALIAS=upload
CHURRASCO_KEYSTORE_PASSWORD=REPLACE
CHURRASCO_KEY_PASSWORD=REPLACE

# Opcional — Remote Config overrides para QA
CHURRASCO_RC_DIFFICULTY_SCALAR=1.0
CHURRASCO_RC_ADS_ENABLED=true
