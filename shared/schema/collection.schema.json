{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/collection.schema.json",
  "title": "Collection",
  "description": "Shape contract for shared/data/collection.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
  "required": [
    "categories",
    "entries",
    "mastery",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nameKey"
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "acompanhamentos",
              "aves",
              "carnes",
              "churrasqueiras",
              "equipamentos",
              "espetinhos",
              "linguicas",
              "molhos",
              "paes",
              "queijos"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "originKey": {
            "type": "string"
          },
          "rarity": {
            "enum": [
              "common",
              "epic",
              "legendary",
              "rare",
              "uncommon"
            ]
          },
          "refId": {
            "type": "string"
          },
          "refType": {
            "enum": [
              "equipment",
              "grillSkin",
              "ingredient",
              "sauce",
              "trophy"
            ]
          }
        },
        "required": [
          "category",
          "id",
          "originKey",
          "rarity",
          "refId",
          "refType"
        ]
      }
    },
    "mastery": {
      "type": "object",
      "properties": {
        "cosmeticOnly": {
          "type": "boolean"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer"
              },
              "titleKey": {
                "enum": [
                  "mastery.assador",
                  "mastery.especialista",
                  "mastery.iniciante",
                  "mastery.mestre"
                ]
              }
            },
            "required": [
              "level",
              "titleKey"
            ]
          }
        },
        "rewardPerLevel": {
          "type": "object",
          "properties": {
            "coins": {
              "type": "integer"
            },
            "embersEvery5": {
              "type": "integer"
            }
          },
          "required": [
            "coins",
            "embersEvery5"
          ]
        },
        "xpFormula": {
          "type": "object",
          "properties": {
            "a": {
              "type": "integer"
            },
            "exponent": {
              "type": "number"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "a",
            "exponent",
            "type"
          ]
        }
      },
      "required": [
        "cosmeticOnly",
        "levels",
        "rewardPerLevel",
        "xpFormula"
      ]
    },
    "version": {
      "type": "integer"
    }
  }
}
