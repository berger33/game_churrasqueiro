{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/pass.schema.json",
  "title": "Season pass",
  "description": "Shape contract for shared/data/pass.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
  "required": [
    "rules",
    "season",
    "tracks",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "properties": {
        "carryoverOnExpire": {
          "type": "string"
        },
        "freeTrackContainsEssentialGameplay": {
          "type": "boolean"
        },
        "maxTierJumpPurchases": {
          "type": "integer"
        },
        "premiumMostlyCosmetic": {
          "type": "boolean"
        },
        "tierJumpProductId": {
          "type": "string"
        }
      },
      "required": [
        "carryoverOnExpire",
        "freeTrackContainsEssentialGameplay",
        "maxTierJumpPurchases",
        "premiumMostlyCosmetic",
        "tierJumpProductId"
      ]
    },
    "season": {
      "type": "object",
      "properties": {
        "durationDays": {
          "type": "integer"
        },
        "premiumProductId": {
          "type": "string"
        },
        "tiers": {
          "type": "integer"
        },
        "xpPerTier": {
          "type": "integer"
        },
        "xpSources": {
          "type": "object",
          "properties": {
            "comboMilestone": {
              "type": "integer"
            },
            "customerServed": {
              "type": "integer"
            },
            "dailyMissionsAll": {
              "type": "integer"
            },
            "eventObjective": {
              "type": "integer"
            },
            "perfectCook": {
              "type": "integer"
            },
            "turnComplete": {
              "type": "integer"
            },
            "weeklyMissionsAll": {
              "type": "integer"
            }
          },
          "required": [
            "comboMilestone",
            "customerServed",
            "dailyMissionsAll",
            "eventObjective",
            "perfectCook",
            "turnComplete",
            "weeklyMissionsAll"
          ]
        }
      },
      "required": [
        "durationDays",
        "premiumProductId",
        "tiers",
        "xpPerTier",
        "xpSources"
      ]
    },
    "tracks": {
      "type": "object",
      "properties": {
        "free": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reward": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer"
                  },
                  "coins": {
                    "type": "integer"
                  },
                  "currency": {
                    "enum": [
                      "embers"
                    ]
                  },
                  "id": {
                    "enum": [
                      "queijo_coalho",
                      "season_chest_free",
                      "tip_2x",
                      "xp_2x"
                    ]
                  },
                  "type": {
                    "enum": [
                      "booster",
                      "chest",
                      "ingredient"
                    ]
                  }
                }
              },
              "tier": {
                "type": "integer"
              }
            },
            "required": [
              "reward",
              "tier"
            ]
          }
        },
        "premium": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reward": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer"
                  },
                  "coins": {
                    "type": "integer"
                  },
                  "currency": {
                    "enum": [
                      "embers"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "type": {
                    "enum": [
                      "collection",
                      "decor",
                      "sign",
                      "skin"
                    ]
                  }
                }
              },
              "tier": {
                "type": "integer"
              }
            },
            "required": [
              "reward",
              "tier"
            ]
          }
        }
      },
      "required": [
        "free",
        "premium"
      ]
    },
    "version": {
      "type": "integer"
    }
  }
}
