{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/tutorial.schema.json",
  "title": "FTUE script (six-step first run, docs/05-UX_FLOW.md section 4)",
  "description": "Shape contract for shared/data/tutorial.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
  "required": [
    "coach",
    "skip",
    "steps",
    "targetDurationSec",
    "turn",
    "upgradeTrackId",
    "variant",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_coach": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "coach": {
      "type": "object",
      "properties": {
        "flipPromptAtSideDoneness": {
          "type": "number"
        },
        "handLoopSec": {
          "type": "number"
        },
        "holdBelowWindowHi": {
          "type": "number"
        },
        "idleHintSec": {
          "type": "integer"
        },
        "serveReadyMinDoneness": {
          "type": "number"
        }
      },
      "required": [
        "flipPromptAtSideDoneness",
        "handLoopSec",
        "holdBelowWindowHi",
        "idleHintSec",
        "serveReadyMinDoneness"
      ]
    },
    "skip": {
      "type": "object",
      "properties": {
        "hitSizePx": {
          "type": "integer"
        },
        "labelKey": {
          "type": "string"
        },
        "showAfterSec": {
          "type": "integer"
        }
      },
      "required": [
        "hitSizePx",
        "labelKey",
        "showAfterSec"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "completesOn": {
            "type": "string"
          },
          "event": {
            "enum": [
              "tutorial_complete",
              "tutorial_step"
            ]
          },
          "gesture": {
            "enum": [
              "drag",
              "none",
              "tap"
            ]
          },
          "hintKey": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "index": {
            "type": "integer"
          },
          "screen": {
            "enum": [
              "home",
              "play"
            ]
          }
        },
        "required": [
          "completesOn",
          "event",
          "gesture",
          "id",
          "index",
          "screen"
        ]
      },
      "minItems": 6,
      "description": "§8 content floor: at least 6 entries."
    },
    "targetDurationSec": {
      "type": "integer"
    },
    "turn": {
      "type": "object",
      "properties": {
        "churrasqueiraId": {
          "type": "string"
        },
        "customerPatienceSec": {
          "type": "integer"
        },
        "customers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "customerId": {
                "type": "string"
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "customerId",
              "order"
            ]
          }
        },
        "ingredientId": {
          "type": "string"
        },
        "levelId": {
          "type": "string"
        },
        "safetyLimitSec": {
          "type": "integer"
        },
        "windDownSec": {
          "type": "number"
        }
      },
      "required": [
        "churrasqueiraId",
        "customerPatienceSec",
        "customers",
        "ingredientId",
        "levelId",
        "safetyLimitSec",
        "windDownSec"
      ]
    },
    "upgradeTrackId": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    }
  }
}
