    "stops",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "emberPointSources": {
      "type": "object",
      "properties": {
        "comboMilestone": {
          "type": "integer"
        },
        "customerServed": {
          "type": "integer"
        },
        "dailyMissionsAll": {
          "type": "integer"
        },
        "perfectCook": {
          "type": "integer"
        },
        "turnFlawless": {
          "type": "integer"
        },
        "weeklyMissionsAll": {
          "type": "integer"
        }
      },
      "required": [
        "comboMilestone",
        "customerServed",
        "dailyMissionsAll",
        "perfectCook",
        "turnFlawless",
        "weeklyMissionsAll"
      ]
    },
    "postLaunchExpansion": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "stopsPerSeason": {
          "type": "integer"
        }
      },
      "required": [
        "note",
        "stopsPerSeason"
      ]
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "challenge": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "integer"
              },
              "ingredient": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "bossTurn",
                  "combo",
                  "flawlessTurns",
                  "ingredient",
