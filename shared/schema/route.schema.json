              "coins": {
                "type": "integer"
              },
              "collection": {
                "type": "string"
              },
              "decor": {
                "type": "string"
              },
              "embers": {
                "type": "integer"
              },
              "equipment": {
                "type": "string"
              },
              "ingredient": {
                "enum": [
                  "carne_de_sol",
                  "costela",
                  "maminha",
                  "pao_de_alho"
                ]
              },
              "skin": {
                "type": "string"
              }
            }
          },
          "storyKey": {
            "type": "string"
          }
        },
        "required": [
          "challenge",
          "emberCost",
          "id",
          "index",
          "nameKey",
          "region",
          "reward",
          "storyKey"
        ]
      }
    },
