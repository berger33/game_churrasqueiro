{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/route.schema.json",
  "title": "Route stops",
  "description": "Shape contract for shared/data/route.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
  "required": [
