          },
          "emberCost": {
            "type": "integer"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "index": {
            "type": "integer"
          },
          "nameKey": {
            "type": "string"
          },
          "region": {
            "enum": [
              "centro_oeste",
              "nordeste",
              "norte",
              "sudeste",
              "sul"
            ]
          },
          "reward": {
            "type": "object",
