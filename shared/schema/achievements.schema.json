{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/achievements.schema.json",
  "title": "Achievements",
  "description": "Shape contract for shared/data/achievements.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
  "required": [
    "achievements",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descKey": {
            "type": "string"
          },
          "goal": {
            "type": "integer"
          },
          "humor": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameKey": {
            "type": "string"
          },
          "reward": {
            "type": "object",
            "properties": {
              "coins": {
                "type": "integer"
              },
              "collection": {
                "enum": [
                  "carvao_de_estimacao",
                  "coroa_da_brasa",
                  "livro_dourado",
                  "medalha_picanha"
                ]
              },
              "embers": {
                "type": "integer"
              }
            }
          },
          "stat": {
            "enum": [
              "bestCombo",
              "burnedFood",
              "category.skewer.served",
              "coinsEarnedTotal",
              "collectionEntries",
              "customersServed",
              "dailyMissionsComplete",
              "employeesHired",
              "eventsCompleted",
              "flawlessTurns",
              "food.costela.served",
              "food.linguica_toscana.served",
              "food.pao_de_alho.served",
              "food.picanha.perfect",
              "food.queijo_coalho.perfect",
              "idleCollections",
              "loginStreak",
              "ordersCompleted",
              "passTiersClaimed",
              "perfectCooks",
              "playerLevel",
              "restaurantsUnlocked",
              "routeStopsCleared",
              "turnsPlayed",
              "upgradesPurchased",
              "vipServed"
            ]
          },
          "tier": {
            "type": "integer"
          }
        },
        "required": [
          "descKey",
          "goal",
          "id",
          "nameKey",
          "reward",
          "stat",
          "tier"
        ]
      },
      "minItems": 30,
      "description": "§8 content floor: at least 30 entries."
    },
    "version": {
      "type": "integer"
    }
  }
}
