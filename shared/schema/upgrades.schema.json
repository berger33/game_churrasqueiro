            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "maxLevel": {
            "type": "integer"
          },
          "nameKey": {
            "type": "string"
          }
        },
        "required": [
          "baseCost",
          "category",
          "currency",
          "descKey",
          "effect",
          "growth",
          "icon",
          "id",
          "maxLevel",
