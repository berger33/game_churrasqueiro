          "currency",
          "id",
          "nameKey",
          "prices"
        ]
      }
    },
    "costFormula": {
      "type": "object",
      "properties": {
        "growth": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "growth",
        "type"
      ]
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "baseCost": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "currency": {
            "enum": [
              "coins",
              "embers"
            ]
          },
          "descKey": {
            "type": "string"
          },
          "effect": {
            "type": "object",
            "properties": {
              "delta": {
                "type": "number"
              },
              "stat": {
                "type": "string"
              }
