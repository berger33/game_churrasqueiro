          "art",
          "burnRate",
          "category",
          "collectionCategory",
          "cookMethod",
          "descKey",
          "flipNeeded",
          "heatRate",
          "id",
          "idealZone",
          "nameKey",
          "perfectWindow",
          "rarity",
          "satisfaction",
          "sideCookSec",
          "sides",
          "unlock",
          "value",
          "xp"
        ]
      },
      "minItems": 12,
      "description": "§8 content floor: at least 12 entries."
    },
    "shared": {
      "type": "object",
      "properties": {
        "burnedThreshold": {
          "type": "number"
        },
        "carryoverRate": {
          "type": "number"
        },
        "defaultPerfectWindow": {
          "type": "array",
          "items": {
            "type": "number"
