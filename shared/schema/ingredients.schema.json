{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/ingredients.schema.json",
  "title": "Ingredients",
  "description": "Shape contract for shared/data/ingredients.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
