          "region": {
            "type": "string"
          },
          "satisfaction": {
            "type": "number"
          },
          "sideCookSec": {
            "type": "number"
          },
          "sides": {
            "enum": [
              1,
              2,
              4
            ]
          },
          "stageOverrides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "max": {
                  "type": "number"
                },
                "nameKey": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "max",
                "nameKey"
              ]
            }
          },
          "unlock": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer"
              },
              "restaurantIndex": {
                "type": "integer"
              }
            },
            "required": [
              "level",
              "restaurantIndex"
            ]
          },
          "value": {
            "type": "integer"
          },
          "xp": {
            "type": "integer"
          }
