    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "art": {
            "type": "object",
            "properties": {
              "bone": {
                "type": "boolean"
              },
              "burnColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "cookedColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "fatCap": {
                "type": "boolean"
              },
              "fatSheen": {
                "type": "boolean"
              },
              "gloss": {
                "type": "number"
              },
              "marbling": {
                "type": "number"
              },
              "meltAmount": {
                "type": "number"
              },
              "rawColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "shape": {
                "type": "string"
              }
            },
            "required": [
              "burnColor",
              "cookedColor",
              "fatSheen",
              "gloss",
              "rawColor",
              "shape"
            ]
          },
          "burnRate": {
            "type": "number"
          },
          "category": {
            "enum": [
              "beef",
              "sausage",
              "poultry",
              "skewer",
              "cheese",
              "bread",
              "sides"
            ]
          },
          "collectionCategory": {
            "enum": [
              "acompanhamentos",
              "aves",
              "carnes",
              "espetinhos",
              "linguicas",
              "paes",
              "queijos"
            ]
          },
          "cookMethod": {
            "enum": [
              "grill",
              "prep"
            ]
          },
          "descKey": {
            "type": "string"
          },
          "flipNeeded": {
            "type": "boolean"
          },
          "heatRate": {
            "type": "number"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "idealZone": {
            "enum": [
              "low",
              "medium",
              "high",
              "none"
            ]
          },
          "nameKey": {
            "type": "string"
          },
          "perfectWindow": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "prepSec": {
            "type": "integer"
          },
          "rarity": {
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic"
