{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/levels.schema.json",
  "title": "Campaign levels",
  "description": "Shape contract for shared/data/levels.json. Generated by tools/studio/gen-schemas.mjs — edit the generator, not this file.",
  "type": "object",
  "required": [
    "generatedBy",
    "levels",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "generatedBy": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "difficulty": {
            "enum": [
              "easy",
              "hard",
              "medium",
              "reward"
            ]
          },
          "difficultyScalar": {
            "type": "number"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "index": {
            "type": "integer"
          },
          "maxOrdersOnScreen": {
            "type": "integer"
          },
          "nameKey": {
            "enum": [
              "level.name.easy",
              "level.name.hard",
              "level.name.medium",
              "level.name.reward"
            ]
          },
          "patienceScalar": {
            "type": "number"
          },
          "restaurantIndex": {
            "type": "integer"
          },
          "rewards": {
            "type": "object",
            "properties": {
              "coins": {
                "type": "integer"
              },
              "embers": {
                "type": "integer"
              },
              "firstClearBonus": {
                "type": "object",
                "properties": {
                  "coins": {
                    "type": "integer"
                  },
                  "xp": {
                    "type": "integer"
                  }
                },
                "required": [
                  "coins",
                  "xp"
                ]
              },
              "xp": {
                "type": "integer"
              }
            },
            "required": [
              "coins",
              "firstClearBonus",
              "xp"
            ]
          },
          "spawnIntervalSec": {
            "type": "number"
          },
          "targetStars3ServedPct": {
            "type": "number"
          },
          "turnLengthSec": {
            "type": "integer"
          },
          "vipChance": {
            "type": "number"
          }
        },
        "required": [
          "difficulty",
          "difficultyScalar",
          "id",
          "index",
          "maxOrdersOnScreen",
          "nameKey",
          "patienceScalar",
          "restaurantIndex",
          "rewards",
          "spawnIntervalSec",
          "targetStars3ServedPct",
          "turnLengthSec",
          "vipChance"
        ]
      },
      "minItems": 50,
      "description": "§8 content floor: at least 50 entries."
    },
    "version": {
      "type": "integer"
    }
  }
}
