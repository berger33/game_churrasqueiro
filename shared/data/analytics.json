{
  "$schema": "schema/analytics.schema.json",
  "_comment": "Analytics taxonomy (spec §59-§61). Validated by tools/studio/validate-data.ts: every event logged in code must exist here, and no event may declare a PII parameter.",
  "version": 4,
  "provider": "firebase_analytics",
  "piiPolicy": {
    "forbiddenParams": ["email", "name", "phone", "cpf", "address", "device_id_raw", "ip", "gps", "user_name"],
    "forbiddenParamSubstrings": ["email", "phone", "cpf", "address", "ip_addr", "lat", "lng", "gps"],
    "userIdAllowed": "anonymous_install_uuid_only"
  },
  "commonParams": {
    "session_id": "string",
    "ab_test_id": "string",
    "app_version": "string",
    "content_version": "string",
    "quality_level": "string"
  },
  "events": [
    { "name": "first_open", "trigger": "first launch after install", "params": { "locale": "string", "device_tier": "string" } },
    { "name": "tutorial_start", "trigger": "FTUE begins", "params": { "variant": "string" } },
    { "name": "tutorial_step", "trigger": "each guided step", "params": { "step": "string", "step_index": "long", "elapsed_ms": "long" } },
    { "name": "tutorial_complete", "trigger": "FTUE finished", "params": { "duration_ms": "long", "misses": "long" } },
    { "name": "tutorial_abandon", "trigger": "app closed during FTUE", "params": { "step": "string", "step_index": "long" } },
    { "name": "session_start", "trigger": "app foregrounded", "params": { "days_since_install": "long", "session_index": "long", "is_returning": "boolean" } },
    { "name": "session_end", "trigger": "app backgrounded", "params": { "session_length_ms": "long", "turns_played": "long" } },
    { "name": "level_start", "trigger": "turn begins", "params": { "level_id": "string", "restaurant_index": "long", "difficulty": "string" } },
    { "name": "level_complete", "trigger": "turn finished successfully", "params": { "level_id": "string", "score": "long", "perfect_count": "long", "burned_count": "long", "lost_customers": "long", "coins_earned": "long", "duration_ms": "long", "best_combo": "long" } },
    { "name": "level_fail", "trigger": "turn failed", "params": { "level_id": "string", "reason": "string", "progress_pct": "double", "burned_count": "long" } },
    { "name": "order_complete", "trigger": "plate served", "params": { "customer_type": "string", "item_count": "long", "quality": "string", "wait_pct": "double", "coins": "long" } },
    { "name": "order_failed", "trigger": "customer leaves unserved", "params": { "customer_type": "string", "reason": "string", "items_missing": "long" } },
    { "name": "perfect_cook", "trigger": "item served in perfect window", "params": { "ingredient": "string", "doneness": "double", "evenness": "double", "combo": "long" } },
    { "name": "burned_food", "trigger": "item crossed burn threshold", "params": { "ingredient": "string", "zone": "string", "time_on_grill_s": "double" } },
    { "name": "combo_reached", "trigger": "combo milestone", "params": { "combo": "long", "milestone": "long" } },
    { "name": "combo_broken", "trigger": "combo reset", "params": { "combo": "long", "reason": "string" } },
    { "name": "restaurant_upgrade", "trigger": "new establishment unlocked", "params": { "restaurant_index": "long", "restaurant_id": "string", "cost_coins": "long", "level": "long" } },
    { "name": "upgrade_purchase", "trigger": "upgrade track level up", "params": { "track_id": "string", "level": "long", "cost_coins": "long" } },
    { "name": "currency_earned", "trigger": "any currency credit", "params": { "currency": "string", "amount": "long", "source": "string", "balance": "long" } },
    { "name": "currency_spent", "trigger": "any currency debit", "params": { "currency": "string", "amount": "long", "sink": "string", "balance": "long" } },
    { "name": "economy_snapshot", "trigger": "once per session end", "params": { "coins": "long", "embers": "long", "coins_earned_session": "long", "coins_spent_session": "long", "level": "long", "restaurant_index": "long" } },
    { "name": "rewarded_offer", "trigger": "rewarded placement shown", "params": { "placement": "string", "context": "string" } },
    { "name": "rewarded_start", "trigger": "ad started", "params": { "placement": "string", "network": "string" } },
    { "name": "rewarded_complete", "trigger": "reward granted", "params": { "placement": "string", "network": "string", "reward_id": "string", "ecpm_micros": "long" } },
    { "name": "rewarded_fail", "trigger": "ad failed or skipped", "params": { "placement": "string", "error": "string" } },
    { "name": "interstitial_impression", "trigger": "interstitial shown", "params": { "placement": "string", "network": "string", "ecpm_micros": "long", "turns_since_last": "long" } },
    { "name": "interstitial_suppressed", "trigger": "interstitial skipped by cap", "params": { "reason": "string" } },
    { "name": "shop_open", "trigger": "store opened", "params": { "source": "string" } },
    { "name": "iap_view", "trigger": "product viewed", "params": { "product_id": "string", "tier": "string", "source": "string" } },
    { "name": "iap_start", "trigger": "purchase flow started", "params": { "product_id": "string" } },
    { "name": "iap_success", "trigger": "purchase acknowledged & granted", "params": { "product_id": "string", "price_micros": "long", "currency_code": "string" } },
    { "name": "iap_fail", "trigger": "purchase error/cancel", "params": { "product_id": "string", "error": "string" } },
    { "name": "iap_restore", "trigger": "purchases restored", "params": { "restored_count": "long" } },
    { "name": "daily_reward", "trigger": "daily calendar claimed", "params": { "day_index": "long", "streak": "long" } },
    { "name": "daily_mission_complete", "trigger": "a daily mission finished", "params": { "mission_id": "string", "all_complete": "boolean" } },
    { "name": "weekly_mission_complete", "trigger": "a weekly mission finished", "params": { "mission_id": "string" } },
    { "name": "event_start", "trigger": "LiveOps event entered", "params": { "event_id": "string", "event_type": "string" } },
    { "name": "event_complete", "trigger": "event objective finished", "params": { "event_id": "string", "progress": "long" } },
    { "name": "pass_tier_claim", "trigger": "pass reward claimed", "params": { "tier": "long", "track": "string" } },
    { "name": "collection_unlock", "trigger": "book entry unlocked", "params": { "entry_id": "string", "category": "string", "rarity": "string" } },
    { "name": "mastery_level", "trigger": "ingredient mastery up", "params": { "ingredient": "string", "level": "long" } },
    { "name": "idle_collect", "trigger": "offline earnings claimed", "params": { "offline_minutes": "long", "coins": "long", "xp": "long", "doubled_by_ad": "boolean" } },
    { "name": "share_capture", "trigger": "share card generated", "params": { "kind": "string", "combo": "long" } },
    { "name": "settings_change", "trigger": "option toggled", "params": { "setting": "string", "value": "string" } },
    { "name": "performance_sample", "trigger": "sampled 1/20 sessions", "params": { "avg_fps": "double", "p1_fps": "double", "draw_calls": "long", "mem_mb": "long", "quality": "string" } },
    { "name": "churn_risk_signal", "trigger": "heuristic risk detected", "params": { "signal": "string", "turns": "long", "last_fail_streak": "long" } },
    { "name": "error_nonfatal", "trigger": "handled exception", "params": { "error_type": "string", "context": "string" } }
  ],
  "funnel": [
    { "id": "install", "event": "first_open" },
    { "id": "tutorial_start", "event": "tutorial_start" },
    { "id": "tutorial_complete", "event": "tutorial_complete" },
    { "id": "first_turn_complete", "event": "level_complete", "filter": "level_id=level_001" },
    { "id": "first_upgrade", "event": "upgrade_purchase" },
    { "id": "d1_return", "event": "session_start", "filter": "days_since_install>=1" },
    { "id": "restaurant_2", "event": "restaurant_upgrade", "filter": "restaurant_index>=1" },
    { "id": "first_rewarded", "event": "rewarded_complete" },
    { "id": "first_purchase", "event": "iap_success" }
  ],
  "kpis": [
    "D1/D3/D7/D14/D30 retention",
    "DAU", "MAU", "DAU/MAU stickiness",
    "avg session length", "sessions per user per day",
    "ARPDAU", "ARPU", "ARPPU", "IAP conversion rate",
    "rewarded views per DAU", "ad impressions per DAU", "eCPM",
    "LTV D7/D30/D90", "CPI", "ROAS",
    "crash-free users (target > 99%)", "ANR rate",
    "tutorial completion rate", "avg turns per session", "avg perfect rate"
  ],
  "dashboards": [
    { "id": "acquisition_funnel", "widgets": ["first_open→tutorial_complete", "tutorial drop-off by step", "first turn completion"] },
    { "id": "retention", "widgets": ["D1-D30 cohorts", "stickiness", "retention by restaurant tier"] },
    { "id": "monetization", "widgets": ["ARPDAU", "conversion", "rewarded per DAU", "eCPM", "offer CTR"] },
    { "id": "gameplay_health", "widgets": ["perfect rate by level", "fail rate by level", "burned rate", "abandon by level"] },
    { "id": "stability", "widgets": ["crash-free users", "top crashes", "ANR", "fps distribution"] }
  ]
}
