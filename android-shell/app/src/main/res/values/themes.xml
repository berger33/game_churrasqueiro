<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only: the shell has no UI of its own, so it needs no AppCompat
         and no AndroidX dependency at all. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/brasa_preto</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
